{
    "name": "flair/worldgen",
    "description": "Genese d'un monde : clubs, competition, staff et population de depart, deterministe pour une graine donnee.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "flair/kernel": "@dev"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Flair\\Worldgen\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flair\\Worldgen\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../kernel"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
