{
    "name": "flair/kernel",
    "description": "Noyau de simulation pur, deterministe, sans dependance runtime.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Flair\\Kernel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flair\\Kernel\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
