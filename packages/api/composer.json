{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "flair/api",
    "description": "Rend le monde visible : couche de lecture unique sur l'event store et les snapshots, servie en JSON et en pages d'administration.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "flair/host": "@dev",
        "laravel/framework": "^13.8"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Flair\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flair\\Api\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "@php artisan serve",
        "analyse": "phpstan analyse --memory-limit=1G",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../host"
        },
        {
            "type": "path",
            "url": "../worldgen"
        },
        {
            "type": "path",
            "url": "../kernel"
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
