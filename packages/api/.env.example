APP_NAME=Flair
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# La base du monde, lue via `flair/host`. Memes defauts que le
# `docker-compose.yml` a la racine du repo, memes noms de variables que le CLI
# du Host - un seul jeu de reglages pour les deux.
FLAIR_DB_HOST=127.0.0.1
FLAIR_DB_PORT=54329
FLAIR_DB_NAME=flair
FLAIR_DB_USER=flair
FLAIR_DB_PASSWORD=flair

# Cette application n'a **aucune base a elle** : elle lit celle du monde par
# `flair/host`. Les pilotes ci-dessous sont donc volontairement sans base -
# les defauts de Laravel (`database`) exigeraient des tables `sessions`,
# `cache` et `jobs` qui n'existent pas et n'ont pas a exister.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
